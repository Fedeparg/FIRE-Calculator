{
  "name": "sextante",
  "version": "0.1.0",
  "private": true,
  "description": "Personal finance and FIRE calculator suite for the Spanish tax system, with an aggregated portfolio and an MCP server.",
  "license": "MIT",
  "author": "Federico Pardo",
  "homepage": "https://sextante.fpardo.net",
  "packageManager": "pnpm@11.6.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "pnpm core:build && next dev",
    "build": "pnpm core:build && next build",
    "start": "next start",
    "lint": "eslint && prettier --check \"**/*.{ts,tsx,js,mjs,css,json}\" && knip",
    "knip": "knip",
    "typecheck": "pnpm core:build && tsc --noEmit && pnpm --filter @sextante/core typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "core:build": "pnpm --filter @sextante/core build",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,css,json}\""
  },
  "dependencies": {
    "@sextante/core": "workspace:*",
    "gray-matter": "^4.0.3",
    "next": "16.3.8",
    "next-intl": "^4.14.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "^3.10.1",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "server-only": "^0.0.1",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.3.8",
    "fast-check": "^4.10.2",
    "jsdom": "^30.1.1",
    "knip": "^6.39.0",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "typescript": "^5",
    "vitest": "^5.0.3"
  }
}
