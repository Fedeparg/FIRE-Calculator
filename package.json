{
  "name": "sextante",
  "version": "0.1.0",
  "private": true,
  "description": "Suite de calculadoras de finanzas personales y FIRE para el sistema fiscal español, con cartera agregada y servidor MCP.",
  "license": "UNLICENSED",
  "author": "Federico Pardo",
  "homepage": "https://sextante.fpardo.net",
  "packageManager": "pnpm@11.6.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "pnpm core:build && next dev",
    "build": "pnpm core:build && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "pnpm core:build && tsc --noEmit && pnpm --filter @sextante/core typecheck",
    "test": "pnpm core:build && vitest run",
    "test:watch": "pnpm core:build && vitest",
    "core:build": "pnpm --filter @sextante/core build"
  },
  "dependencies": {
    "@sextante/core": "workspace:*",
    "gray-matter": "^4.0.3",
    "next": "16.3.5",
    "next-intl": "^4.14.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "^3.10.1",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "server-only": "^0.0.1",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^24",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "fast-check": "^4.10.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
