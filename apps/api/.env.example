# Configuración de la API de Sextante. Copia a `.env` y ajusta.
# NUNCA subas el .env real (está en .gitignore).

# Puerto en el que escucha la API (NestJS).
PORT=3001

# Cadena de conexión a PostgreSQL.
# - En local (drizzle-kit desde el host): apunta a localhost y al puerto expuesto.
# - Dentro de Docker Compose, el host es el nombre del servicio: `postgres`.
DATABASE_URL=postgres://sextante:sextante_dev@localhost:5432/sextante

# Secreto para firmar el JWT de sesión. Genera uno largo y aleatorio:
#   openssl rand -base64 48
JWT_SECRET=dev_insecure_secret_change_me

# Cookie de sesión Secure: false en dev (http://localhost), true en prod (HTTPS).
COOKIE_SECURE=false

# URL del frontend (donde vive /auth/verify); base del magic link.
APP_URL=http://localhost:3000

# Transporte de email: "dev" (escribe el enlace en el log) o "resend" (producción).
EMAIL_TRANSPORT=dev
# Solo si EMAIL_TRANSPORT=resend:
# RESEND_API_KEY=re_...
# EMAIL_FROM=Sextante <no-reply@elsextante.com>
