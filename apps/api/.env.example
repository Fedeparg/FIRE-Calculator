# Sextante API configuration. Copy to `.env` and adjust.
# NEVER commit the real .env (it is in .gitignore).

# Every variable is validated at startup (`src/config/env.ts`): if a required one is missing or
# has an invalid value, the API does not start and lists every failure. An empty variable
# (`VAR=`) counts as unset.

# Environment: development (default), production or test. In production the development
# JWT_SECRET is forbidden and POST /api/prices/refresh is disabled.
# NODE_ENV=development

# Port the API (NestJS) listens on. Default 3001.
PORT=3001

# PostgreSQL connection string.
# - Locally (drizzle-kit from the host): points at localhost and the exposed port.
# - Inside Docker Compose, the host is the service name: `postgres`.
DATABASE_URL=postgres://sextante:sextante_dev@localhost:5432/sextante

# Secret used to sign the session JWT. Generate a long random one:
#   openssl rand -base64 48
JWT_SECRET=dev_insecure_secret_change_me

# Secure session cookie: false in dev (http://localhost), true in prod (HTTPS).
COOKIE_SECURE=false

# Trusted proxy hops in front of the API (Express `trust proxy`). It decides whether `req.ip`
# is the user's REAL IP and, therefore, whether the rate limiting puts everyone in the same
# bucket. Default 1.
# How to choose the number: count the proxies that APPEND to `X-Forwarded-For` between the user
# and this API (typically: TLS reverse proxy = 1; reverse proxy + Next BFF = 2). To check it
# with evidence, request a magic link in production and look at the "Proxy diagnostics" log of
# `POST /api/auth/request`: if `req.ip` does NOT match the leftmost IP of the
# `x-forwarded-for` chain, raise the number. Never set it "high just in case": trusting too
# many hops allows spoofing the IP with a header.
# TRUST_PROXY_HOPS=1

# Frontend URL (where /auth/verify lives); base of the magic link.
APP_URL=http://localhost:3000

# Email transport: "dev" (writes the link to the log) or "resend" (production).
EMAIL_TRANSPORT=dev
# Only if EMAIL_TRANSPORT=resend (in production). If RESEND_API_KEY or EMAIL_FROM is missing, the
# API fails at startup (it does not send into a black hole). Get the key at https://resend.com
# (Settings -> API Keys). NEVER commit the real key: it goes in the server's .env.
# RESEND_API_KEY=re_...
# Sender. REQUIRED with EMAIL_TRANSPORT=resend and with no default: it must be a domain
# verified in YOUR Resend account (see docs/DEPLOY.md, §3 "Email (Resend)"). A dedicated sending
# subdomain is recommended so the root domain's reputation is not put at risk.
# EMAIL_FROM=Sextante <no-reply@send.your-domain>

# OpenFIGI API key to resolve ISIN/ticker → quote symbol. Free at
# https://www.openfigi.com/api ; it works without a key but with a lower rate limit. MIND
# DOCKER: docker-compose does NOT load this file; it reads the key from the `.env` at the repo
# ROOT (or from the host environment) via `${OPENFIGI_API_KEY}`. For `docker compose up` set it
# there too (the root `.env` is gitignored).
OPENFIGI_API_KEY=

# Price refresh cron (optional; 6 fields "s m h D M W"; default
# "0 30 22 * * *" = 22:30 Europe/Madrid).
# PRICE_REFRESH_CRON=0 30 22 * * *
# INTRADAY price refresh (optional; prices and FX only, no snapshots). Default
# "0 0 9-21 * * 1-5" = on the hour from 9:00 to 21:00 Europe/Madrid, Monday to Friday.
# "off" disables it (kill switch if Yahoo starts rate limiting with 429).
# PRICE_INTRADAY_CRON=0 0 9-21 * * 1-5

# --- Periodic cleanup (data retention) ---
# Cron that prunes expired codes/tokens and the tables that grow without bound
# (optional; 6 fields; default "0 15 * * * *" = every hour at minute 15).
# OAUTH_REAPER_CRON=0 15 * * * *
# Days that used or expired magic link tokens are kept (default 30).
# LOGIN_TOKEN_RETENTION_DAYS=30
# Days the audit log of MCP invocations is kept (default 180).
# MCP_AUDIT_RETENTION_DAYS=180
# Days without use after which an OAuth client registered via DCR with NO associated consent
# or token is purged (default 30). Clients in use are never deleted.
# OAUTH_CLIENT_RETENTION_DAYS=30

# --- Donations (Stripe Checkout, "buy me a coffee") ---
# Stripe SECRET key. Without it, the donation endpoints respond
# enabled:false / 503 and the frontend hides the button (startup does not break).
# Get it at https://dashboard.stripe.com/apikeys (use sk_test_... for testing).
# NEVER commit it: it goes in the server's .env. It is the ONLY thing needed;
# the flow redirects to Stripe's hosted URL and uses neither a publishable key nor Stripe.js.
# STRIPE_SECRET_KEY=sk_test_...

# Postgres pool (optional). Idle connection close in seconds (0 = never; default 30), connect
# timeout in seconds (default 10) and per-session `statement_timeout` in milliseconds
# (0 = no limit; default 30000; waiting for a lock also counts).
# DB_IDLE_TIMEOUT_SECONDS=30
# DB_CONNECT_TIMEOUT_SECONDS=10
# DB_STATEMENT_TIMEOUT_MS=30000
