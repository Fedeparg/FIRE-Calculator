# Configuración de la API de Sextante. Copia a `.env` y ajusta.
# NUNCA subas el .env real (está en .gitignore).

# Puerto en el que escucha la API (NestJS).
PORT=3001

# Cadena de conexión a PostgreSQL.
# - En local (drizzle-kit desde el host): apunta a localhost y al puerto expuesto.
# - Dentro de Docker Compose, el host es el nombre del servicio: `postgres`.
DATABASE_URL=postgres://sextante:sextante_dev@localhost:5432/sextante

# Secreto para firmar el JWT de sesión. Genera uno largo y aleatorio:
#   openssl rand -base64 48
JWT_SECRET=dev_insecure_secret_change_me

# Cookie de sesión Secure: false en dev (http://localhost), true en prod (HTTPS).
COOKIE_SECURE=false

# Saltos de proxy de confianza por delante de la API (Express `trust proxy`). De él depende
# que `req.ip` sea la IP REAL del usuario y, por tanto, que el rate limiting no meta a todo
# el mundo en el mismo cubo. Por defecto 1.
# Cómo decidir el número: cuenta los proxies que AÑADEN a `X-Forwarded-For` entre el usuario
# y esta API (típicamente: reverse proxy TLS = 1; reverse proxy + BFF de Next = 2). Para
# comprobarlo con evidencia, pide un magic link en producción y mira el log
# "Diagnóstico de proxy" de `POST /api/auth/request`: si `req.ip` NO coincide con la IP más
# a la izquierda de la cadena `x-forwarded-for`, sube el número. Nunca lo pongas "muy alto
# por si acaso": confiar de más permite falsificar la IP con una cabecera.
# TRUST_PROXY_HOPS=1

# URL del frontend (donde vive /auth/verify); base del magic link.
APP_URL=http://localhost:3000

# Transporte de email: "dev" (escribe el enlace en el log) o "resend" (producción).
EMAIL_TRANSPORT=dev
# Solo si EMAIL_TRANSPORT=resend (en producción). Si falta RESEND_API_KEY o EMAIL_FROM, la
# API falla al arrancar (no envía a un agujero negro). Saca la key en https://resend.com
# (Settings -> API Keys). NUNCA subas la key real al repo: va en el .env del servidor.
# RESEND_API_KEY=re_...
# Remitente. OBLIGATORIO con EMAIL_TRANSPORT=resend y sin valor por defecto: debe ser un
# dominio verificado en TU cuenta de Resend (ver README -> "Email (Resend)"). Se recomienda
# un subdominio de envío dedicado para no comprometer la reputación del dominio raíz.
# EMAIL_FROM=Sextante <no-reply@send.tu-dominio>

# API key de OpenFIGI para resolver ISIN/ticker → símbolo de cotización. Gratis en
# https://www.openfigi.com/api ; sin key funciona pero con rate-limit más bajo. OJO con
# DOCKER: docker-compose NO carga este fichero; lee la key del `.env` de la RAÍZ del repo
# (o del entorno del host) vía `${OPENFIGI_API_KEY}`. Para `docker compose up` ponla
# también ahí (el `.env` raíz está gitignored).
OPENFIGI_API_KEY=

# Cron del refresco de precios (opcional; 6 campos "s m h D M W"; por defecto
# "0 30 22 * * *" = 22:30 Europe/Madrid).
# PRICE_REFRESH_CRON=0 30 22 * * *
# Refresco INTRADÍA de precios (opcional; solo precios y FX, sin snapshots). Por defecto
# "0 0 9-21 * * 1-5" = en punto de 9:00 a 21:00 Europe/Madrid, de lunes a viernes.
# "off" lo desactiva (interruptor si Yahoo empieza a limitar con 429).
# PRICE_INTRADAY_CRON=0 0 9-21 * * 1-5

# --- Limpieza periódica (retención de datos) ---
# Cron de la poda de códigos/tokens caducados y de las tablas que crecen sin límite
# (opcional; 6 campos; por defecto "0 15 * * * *" = cada hora en el minuto 15).
# OAUTH_REAPER_CRON=0 15 * * * *
# Días que se conservan los tokens de magic link ya usados o caducados (por defecto 30).
# LOGIN_TOKEN_RETENTION_DAYS=30
# Días que se conserva el log de auditoría de invocaciones MCP (por defecto 180).
# MCP_AUDIT_RETENTION_DAYS=180
# Días sin uso tras los que se purga un cliente OAuth registrado por DCR que no tenga NINGÚN
# consentimiento ni token asociado (por defecto 30). Los clientes en uso nunca se borran.
# OAUTH_CLIENT_RETENTION_DAYS=30

# --- Donaciones (Stripe Checkout, "invítame a un café") ---
# Clave SECRETA de Stripe. Sin ella, los endpoints de donación responden
# enabled:false / 503 y el frontend no muestra el botón (no rompe el arranque).
# Sácala en https://dashboard.stripe.com/apikeys (usa sk_test_... para probar).
# NUNCA la subas al repo: va en el .env del servidor. Es lo ÚNICO que hace falta;
# el flujo redirige a la URL alojada de Stripe, no usa publishable key ni Stripe.js.
# STRIPE_SECRET_KEY=sk_test_...
