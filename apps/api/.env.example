# Configuración de la API de Sextante. Copia a `.env` y ajusta.
# NUNCA subas el .env real (está en .gitignore).

# Puerto en el que escucha la API (NestJS).
PORT=3001

# Cadena de conexión a PostgreSQL.
# - En local (drizzle-kit desde el host): apunta a localhost y al puerto expuesto.
# - Dentro de Docker Compose, el host es el nombre del servicio: `postgres`.
DATABASE_URL=postgres://sextante:sextante_dev@localhost:5432/sextante
