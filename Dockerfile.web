# Imagen del frontend (Next.js 16, App Router + BFF). Node 24 LTS.
# Multi-etapa: build (instala deps del front + `next build` en modo standalone)
# -> runtime delgado que solo lleva la salida autocontenida (server.js + el
# node_modules mínimo que Next traza). Ver `output: "standalone"` en next.config.
#
# Contexto de build = raíz del repo (monorepo pnpm). El `.dockerignore` de la
# raíz mantiene el contexto pequeño y fuera cualquier `.env`.

# ---- Base común ----
FROM node:24-slim AS base
ENV CI=true
RUN corepack enable
WORKDIR /app

# ---- Build ----
FROM base AS build
# Manifiestos primero (cachea la instalación). Se copian también los del
# workspace (apps/api) para que `--frozen-lockfile` valide el lockfile completo.
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml ./
COPY apps/api/package.json ./apps/api/package.json
RUN pnpm install --frozen-lockfile --filter freedom-calculator...

# URL de la API. CRÍTICO: el rewrite /api/* de next.config se evalúa en BUILD
# TIME y se congela en el manifiesto (el server standalone NO lo recalcula en
# runtime). Por eso API_URL debe estar presente en `next build`, no solo como env
# de runtime. En producción se hornea la red interna de Compose (http://api:3001):
# el server de Next resuelve el destino en cada request, ya dentro de esa red.
ARG API_URL=http://api:3001
ENV API_URL=$API_URL

# Variables PÚBLICAS de AdSense: Next las inlinea en el bundle en BUILD TIME, así
# que tienen que estar presentes durante `next build` (no en runtime). Vacías por
# defecto → el script de AdSense no se carga. Cuando se active la publicidad, el
# workflow las pasa como build-args. NO son secretos (son IDs públicos).
ARG NEXT_PUBLIC_ADSENSE_CLIENT_ID=""
ARG NEXT_PUBLIC_ADSENSE_SLOT=""
ENV NEXT_PUBLIC_ADSENSE_CLIENT_ID=$NEXT_PUBLIC_ADSENSE_CLIENT_ID
ENV NEXT_PUBLIC_ADSENSE_SLOT=$NEXT_PUBLIC_ADSENSE_SLOT

# Interruptor PÚBLICO de donaciones ("invítame a un café"): se inlinea en BUILD TIME
# igual que AdSense. "1" muestra el botón/sección; vacío lo oculta. No es secreto (la
# clave secreta de Stripe vive solo en el backend, ver el servicio `api`).
ARG NEXT_PUBLIC_DONATIONS_ENABLED=""
ENV NEXT_PUBLIC_DONATIONS_ENABLED=$NEXT_PUBLIC_DONATIONS_ENABLED

# Código del front y compilación. `output: "standalone"` genera
# .next/standalone (server.js + node_modules mínimo) y .next/static aparte.
COPY . .
RUN pnpm build

# ---- Runtime ----
FROM node:24-slim AS runtime
WORKDIR /app
ENV NODE_ENV=production
# El servidor escucha en 0.0.0.0:3000 por defecto (Next standalone).
ENV HOSTNAME=0.0.0.0
ENV PORT=3000

# Salida autocontenida: server.js + node_modules trazado.
COPY --from=build /app/.next/standalone ./
# Estáticos y assets públicos (Next standalone NO los incluye).
COPY --from=build /app/.next/static ./.next/static
COPY --from=build /app/public ./public

EXPOSE 3000
CMD ["node", "server.js"]
