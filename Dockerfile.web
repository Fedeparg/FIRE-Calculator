# syntax=docker/dockerfile:1
# Imagen del frontend (Next.js 16, App Router + BFF). Node 24 LTS.
# Multi-etapa: build (instala deps del front + `next build` en modo standalone)
# -> runtime delgado que solo lleva la salida autocontenida (server.js + el
# node_modules mínimo que Next traza). Ver `output: "standalone"` en next.config.
#
# Contexto de build = raíz del repo (monorepo pnpm). El `.dockerignore` de la
# raíz mantiene el contexto pequeño y fuera cualquier `.env`.

# ---- Base común ----
FROM node:24-slim AS base
ENV CI=true
RUN corepack enable
# Store de pnpm en una ruta fija para poder montarla como caché de BuildKit: así
# `pnpm install` no re-descarga todo el árbol cuando cambia el lockfile.
RUN pnpm config set store-dir /pnpm/store
WORKDIR /app

# ---- Build ----
FROM base AS build
# Manifiestos primero (cachea la instalación). Se copian también los del
# workspace (apps/api, packages/core) para que `--frozen-lockfile` valide el lockfile
# completo. El filtro `sextante...` instala la raíz (el frontend) y sus dependencias
# del workspace (@sextante/core), no la API.
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml ./
COPY apps/api/package.json ./apps/api/package.json
COPY packages/core/package.json ./packages/core/package.json
RUN --mount=type=cache,id=pnpm,target=/pnpm/store \
    pnpm install --frozen-lockfile --filter "sextante..."

# URL de la API. CRÍTICO: el rewrite /api/* de next.config se evalúa en BUILD
# TIME y se congela en el manifiesto (el server standalone NO lo recalcula en
# runtime). Por eso API_URL debe estar presente en `next build`, no solo como env
# de runtime. En producción se hornea la red interna de Compose (http://api:3001):
# el server de Next resuelve el destino en cada request, ya dentro de esa red.
ARG API_URL=http://api:3001
ENV API_URL=$API_URL

# URL canónica pública del sitio. Next la inlinea (metadataBase, canonical,
# hreflang) y la usan sitemap.xml y robots.txt para emitir URLs absolutas. Se
# hornea en BUILD TIME (NEXT_PUBLIC_*), así que DEBE estar presente en `next
# build`: si falta, el código cae a http://localhost:3000 y el sitemap queda
# inservible para Google. El default local solo cubre un `docker build` suelto;
# en prod el compose la exige (ver docker-compose.prod.yml).
ARG NEXT_PUBLIC_SITE_URL="http://localhost:3000"
ENV NEXT_PUBLIC_SITE_URL=$NEXT_PUBLIC_SITE_URL

# Interruptor PÚBLICO de donaciones ("invítame a un café"): se inlinea en BUILD TIME
# (como toda NEXT_PUBLIC_). "1" muestra el botón/sección; vacío lo oculta. No es secreto (la
# clave secreta de Stripe vive solo en el backend, ver el servicio `api`).
ARG NEXT_PUBLIC_DONATIONS_ENABLED=""
ENV NEXT_PUBLIC_DONATIONS_ENABLED=$NEXT_PUBLIC_DONATIONS_ENABLED

# Analítica propia (Umami). ANALYTICS_URL es interna (como API_URL, los rewrites de
# /stats/* se congelan en build); el ID de sitio es PÚBLICO y se inlinea en build.
# Vacíos = sin analítica: ni rewrites ni script.
ARG ANALYTICS_URL=""
ENV ANALYTICS_URL=$ANALYTICS_URL
ARG NEXT_PUBLIC_ANALYTICS_WEBSITE_ID=""
ENV NEXT_PUBLIC_ANALYTICS_WEBSITE_ID=$NEXT_PUBLIC_ANALYTICS_WEBSITE_ID

# Código del front y compilación. `pnpm build` compila antes @sextante/core (su
# `dist/` no viaja en el contexto: lo excluye .dockerignore). `output: "standalone"`
# genera .next/standalone (server.js + node_modules mínimo) y .next/static aparte.
COPY . .
RUN pnpm build

# ---- Runtime ----
FROM node:24-slim AS runtime
WORKDIR /app
ENV NODE_ENV=production
# El servidor escucha en 0.0.0.0:3000 por defecto (Next standalone).
ENV HOSTNAME=0.0.0.0
ENV PORT=3000

# Salida autocontenida: server.js + node_modules trazado. Se copia ya con el
# usuario `node` como dueño para poder correr sin privilegios (ver USER abajo).
COPY --from=build --chown=node:node /app/.next/standalone ./
# Estáticos y assets públicos (Next standalone NO los incluye).
COPY --from=build --chown=node:node /app/.next/static ./.next/static
COPY --from=build --chown=node:node /app/public ./public

# Sin privilegios: si alguien logra ejecutar código en el contenedor, no lo hace
# como root. La imagen `node` ya trae el usuario `node` (uid 1000). El servidor
# escucha en el 3000, que no es privilegiado, así que no hace falta root para nada.
USER node

EXPOSE 3000
CMD ["node", "server.js"]
