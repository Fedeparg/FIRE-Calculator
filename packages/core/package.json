{
  "name": "@sextante/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Lógica pura de Sextante (calculadoras, motor de proyección, motor fiscal español, divisas) compartida por el frontend y la API.",
  "license": "UNLICENSED",
  "exports": {
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^24.13.6",
    "fast-check": "^4.10.2",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
