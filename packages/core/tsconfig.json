{
  // `nodenext` because the API consumes it (ESM on Node): it forces relative imports to be
  // written with `.js`, which the Next bundler also understands. That way the same code
  // compiles the same for both consumers.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    // `list[i]` is typed `T | undefined`: every index that may be missing is handled in plain
    // sight (a guard, a default value, or `itemAt` from `arrays.ts` if the bounds are an invariant).
    "noUncheckedIndexedAccess": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "rootDir": "./src",
    "outDir": "./dist"
  },
  // `tsc --noEmit` (typecheck) also covers the tests; the build excludes them.
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
