# Backup service image. Based on postgres:17-alpine to get a pg_dump of the SAME
# major version as the server (avoids dump incompatibilities).
# Adds gnupg (AES256 encryption) and rclone (upload to Google Drive).
FROM postgres:17-alpine

RUN apk add --no-cache gnupg rclone tzdata

COPY scripts/backup/backup.sh /usr/local/bin/backup.sh
COPY scripts/backup/entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/backup.sh /usr/local/bin/entrypoint.sh

# Replaces the postgres image's entrypoint (we do not start a server here).
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
