{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  // An export used only inside its own file is not dead (e.g. a type exported for
  // clarity), so it is not reported.
  "ignoreExportsUsedInFile": true,
  "workspaces": {
    // Next.js frontend: the entries (pages, layouts, route handlers, proxy,
    // next.config) are detected by the Next plugin.
    ".": {
      // Includes the CSS so knip sees Tailwind's `@import`/`@plugin`.
      "project": ["src/**/*.{ts,tsx,css}"]
    },
    "apps/api": {
      // `migrate.ts` is not imported: the Compose `migrate` service runs it
      // as `node dist/db/migrate.js`.
      "entry": ["src/main.ts", "src/db/migrate.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    // `@sextante/core` exposes every file in `src` via `exports: ./*`; knip
    // treats it as an entry, and `includeEntryExports` reports its exports
    // when nobody (another package or its own file) uses them.
    "packages/core": {
      "project": ["src/**/*.ts"],
      "includeEntryExports": true
    }
  }
}
