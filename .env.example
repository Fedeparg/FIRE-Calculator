# === Plantilla de variables de entorno ===
# Copia este archivo a `.env` y rellena con valores reales.
# `.env` está en .gitignore — NUNCA lo subas. Las claves secretas viven SOLO
# en el servidor; nada de esto se expone al frontend salvo lo marcado PUBLIC.

# --- App ---
NODE_ENV=development
APP_URL=http://localhost:5173

# --- Wiki / contenido (revalidación bajo demanda) ---
# Token para el endpoint POST /api/revalidate. Tras editar los Markdown de la
# wiki en el servidor (content/wiki/*.md), un webhook llama a ese endpoint con
# este token y el contenido nuevo queda en vivo sin redesplegar la app.
# Genera uno largo y aleatorio. SECRETO, solo servidor (sin NEXT_PUBLIC_).
REVALIDATE_TOKEN=cambia-esto-por-un-token-largo-aleatorio

# --- Base de datos ---
# Local (SQLite) para arrancar:
DATABASE_URL=file:./data/dev.sqlite
# Producción (Postgres) — ejemplo:
# DATABASE_URL=postgresql://user:password@localhost:5432/freedom

# --- Autenticación ---
AUTH_SECRET=cambia-esto-por-un-secreto-largo-aleatorio
# OAuth (opcional, si añadimos login con Google/GitHub):
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# --- Datos de inversión (server-side, ver _local/datos-inversiones-api.md) ---
OPENFIGI_API_KEY=
TWELVE_DATA_API_KEY=
# EODHD_API_KEY=

# --- Monetización ---
# AdSense: el Publisher ID es público por diseño (NEXT_PUBLIC_ lo expone al
# cliente). Si está vacío, no se renderiza ningún hueco de anuncio.
NEXT_PUBLIC_ADSENSE_CLIENT_ID=
# Stripe (donaciones) — SECRETO, solo servidor:
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Observabilidad (opcional) ---
# SENTRY_DSN=
