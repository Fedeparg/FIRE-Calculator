# === FRONTEND environment variables (Next.js, repo root) ===
# Copy this file to `.env` and fill in real values.
# `.env` is in .gitignore — NEVER commit it.
#
# IMPORTANT: this file declares ONLY what the frontend consumes. BACKEND secrets
# (JWT, database, Resend, OpenFIGI, etc.) live in `apps/api/.env` — see
# `apps/api/.env.example`. Do not duplicate them here.
#
# Golden rule: nothing secret gets the NEXT_PUBLIC_ prefix (that exposes it to the
# browser). Only values that are public by design (the site URL, the donations
# switch) carry that prefix.

# --- App ---
NODE_ENV=development

# Canonical public URL of the site (no trailing slash). Used by SEO (metadataBase,
# canonical, hreflang), the sitemap, robots.txt and the Open Graph images to build
# absolute URLs. PUBLIC by design (not a secret): the domain is already visible.
# In dev it may stay empty (http://localhost:3000 is the default); in production it
# MUST point at the real domain. CAUTION: like every NEXT_PUBLIC_ variable, it is
# inlined at build time, so it must be present when building the prod image.
NEXT_PUBLIC_SITE_URL=https://sextante.fpardo.net

# API (NestJS) URL for Next's rewrites and the server-side session fetch. In dev:
# the local API. In production (Compose): the internal network, http://api:3001.
# SECRET/internal: it does NOT get NEXT_PUBLIC_.
API_URL=http://localhost:3001

# --- Wiki / content (on-demand revalidation) ---
# Token for the POST /api/revalidate endpoint. After editing the wiki Markdown on the
# server, a webhook calls that endpoint with this token and the new content goes
# live without a redeploy. Generate a long random one (openssl rand -base64 32).
# SECRET, server only (no NEXT_PUBLIC_).
REVALIDATE_TOKEN=change-me-to-a-long-random-token

# --- Donations ("buy me a coffee", Stripe) ---
# PUBLIC switch (not a secret): "1" shows the donation button/section on the landing
# page, the footer and /sobre-mi; empty/0 hides them completely. Set it to "1" at the
# same time as you define STRIPE_SECRET_KEY in `apps/api/.env` (the secret key lives
# ONLY in the backend; the frontend never sees it). CAUTION: like every NEXT_PUBLIC_
# variable, it is inlined at build time, so it must be present when building the
# production image.
NEXT_PUBLIC_DONATIONS_ENABLED=

# --- Self-hosted analytics (Umami, cookieless) ---
# Internal Umami URL for the /stats/* rewrites (like API_URL, frozen at build time).
# Empty = nothing is proxied. In production (Compose): http://analytics:3000.
ANALYTICS_URL=
# Site ID in the Umami dashboard (a UUID). PUBLIC by design: it travels in the
# script's attribute. Empty or invalid = the tracker is not loaded. It only tracks
# on the NEXT_PUBLIC_SITE_URL domain, so locally it records nothing even if set.
NEXT_PUBLIC_ANALYTICS_WEBSITE_ID=
